# Aiven MySQL connection
MYSQL_HOST=your-host.aivencloud.com
MYSQL_PORT=12345
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=defaultdb

# Aiven CA certificate (paste the full PEM content on one line, no line breaks)
MYSQL_CA_CERT=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----

# Session / JWT signing secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-me-to-a-random-string
JWT_SECRET=change-me-to-a-different-random-string

# Admin seed (used by: node db/seed-admin.mjs)
ADMIN_EMAIL=admin@polarfiber.com
ADMIN_NAME=Polar Admin
ADMIN_PASSWORD=change-me-min-12-chars
