# Aiven MySQL connection
MYSQL_HOST=your-host.aivencloud.com
MYSQL_PORT=12345
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=defaultdb

# Aiven CA certificate (paste the full PEM content on one line)
MYSQL_CA_CERT=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----

# Session signing secret (any random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-me-to-a-random-string
